# Copy this file to .env and fill in real values.
# .env is gitignored. This file is committed and must never contain a real secret.
#
# Not every module uses every variable. The comment on each group says which
# module introduces it. A single shared .env is used by all modules; each
# module's config.py resolves it by walking up to the repository root.

# --- general (module 05) ---
APP_NAME=FastAPI Learning Journey
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- cors (module 07) ---
# comma separated, no spaces. use explicit origins, never "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# --- database (module 11) ---
# sqlite for development. module 16 switches this to a postgresql url.
DATABASE_URL=sqlite:///./app.db
TEST_DATABASE_URL=sqlite:///./test.db

# --- authentication (module 12) ---
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- file upload (module 13) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- llm provider (module 17) ---
# Google Gemini free tier. Get a key from https://aistudio.google.com/apikey
#
# Comma separated pool. The client tries keys in order and advances to the next
# one when a key returns 429 (quota exhausted) or 403 (key invalid or revoked).
# A single key is fine - the pool is a list of one.
#
# Read the note in guide.md module 17 before adding keys from multiple Google
# accounts. Doing that to multiply free quota breaches Google's terms of service.
GEMINI_API_KEYS=

# verify the current free-tier model name in Google AI Studio before use
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# rate limit applied by our own api, separate from the provider's quota
LLM_RATE_LIMIT=10/minute

# --- optional fallback provider (module 17) ---
# a second free-tier, openai-compatible provider used when every Gemini key is
# exhausted. leave blank to disable.
FALLBACK_BASE_URL=
FALLBACK_API_KEYS=
FALLBACK_MODEL=
