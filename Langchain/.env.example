# copy this file to .env and fill in the values
# get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# optional extra keys, comma separated, used automatically when the keys before
# them run out of quota. each key must come from a SEPARATE Google Cloud
# project, because the free tier quota is counted per project. create extra
# projects at https://console.cloud.google.com/projectcreate
GOOGLE_API_KEYS=

# the model to prefer.
# run "python 01-Models/list_models.py --probe" to find a working name.
GEMINI_MODEL=gemini-3.5-flash

# tried in order when the preferred model runs out of its daily 20 requests.
# each model has its own allowance, so this is the cheapest way to keep working.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash-lite

# turns off the model's internal reasoning step, so short answers do not spend
# the whole token budget thinking. models that reject the parameter are retried
# without it automatically. leave empty to never send it.
GEMINI_THINKING_BUDGET=0

# embeddings, used from module 06 onward. these have their own free tier
# allowance, separate from the chat models above.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_FALLBACK_MODELS=models/gemini-embedding-2

# optional. truncates vectors to this many dimensions, which saves storage in
# the vector database modules. leave empty for the model default of 3072.
# note that truncated vectors are NOT unit length and must be normalised before
# any dot product comparison. see 06-Embeddings/README.md
GEMINI_EMBEDDING_DIM=
